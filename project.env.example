# Copy to project.env (git-ignored) and fill in. Never commit real values.
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_CHAT_ID=replace-with-telegram-group-chat-id
# Optional: chat for "radar degraded" messages.
TELEGRAM_OPS_CHAT_ID=replace-with-telegram-ops-chat-id
# Optional: Google service account key for the settings sheet, as one line of JSON (docs/deploy.md).
GOOGLE_SERVICE_ACCOUNT_JSON=replace-with-single-line-service-account-json
