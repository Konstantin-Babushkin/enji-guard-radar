# Copy to .env (git-ignored) and fill in. Environment variables override this file.
# Never commit the bot token and never paste it into chat, logs or issues.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: a chat for "radar degraded" messages.
TELEGRAM_OPS_CHAT_ID=
# Optional: the Google service account key for the settings sheet (docs/deploy.md), as ONE line
# of JSON. Only read when `sheet.enabled` is true in radar.yaml.
GOOGLE_SERVICE_ACCOUNT_JSON=
